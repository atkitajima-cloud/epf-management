{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "action", "task"],
  "properties": {
    "message": { "type": "string" },
    "action": { "type": "string", "enum": ["none", "create_task", "generate_wbs"] },
    "task": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "status", "owner", "priority", "requirement", "body"],
          "properties": {
            "title": { "type": "string" },
            "status": { "type": "string", "enum": ["backlog", "ready", "doing", "review", "done"] },
            "owner": { "type": "string" },
            "priority": { "type": "string", "enum": ["low", "medium", "high"] },
            "requirement": { "type": "string", "pattern": "^REQ-[0-9]{4}$" },
            "body": { "type": "string" }
          }
        }
      ]
    }
  }
}
